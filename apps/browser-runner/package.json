{
  "name": "@careerpilot/browser-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./src/*.js": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@careerpilot/application": "workspace:*",
    "@careerpilot/domain": "workspace:*",
    "@careerpilot/infrastructure": "workspace:*",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.14.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}
